{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "thethunderturner/laravel-tmdb",
    "description": "A way to access TMDB from Laravel",
    "keywords": [
        "laravel",
        "thethunderturner",
        "laravel-tmdb",
        "tmdb"
    ],
    "homepage": "https://github.com/thethunderturner/laravel-tmdb",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthew Biskas",
            "email": "matthewbiskas@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "guzzlehttp/psr7": "^2.9|^3.0",
        "illuminate/support": "^12.0||^13.0",
        "symfony/event-dispatcher": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "LaravelTmdb\\LaravelTmdb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelTmdb\\LaravelTmdb\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelTmdb\\LaravelTmdb\\LaravelTMDBServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
